{
  "id": "no.joymyr.sesam-pay",
  "version": "1.0.7",
  "compatibility": ">=12.4.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Sesam Pay",
    "no": "Sesam Pay"
  },
  "description": {
    "en": "Never pay a parking service fee again.",
    "no": "Aldri betal servicetillegg på parkering igjen."
  },
  "category": [
    "tools"
  ],
  "brandColor": "#2563eb",
  "homeyCommunityTopicId": 159405,
  "source": "https://github.com/joymyr/sesam_pay",
  "bugs": {
    "url": "https://github.com/joymyr/sesam_pay/issues"
  },
  "author": {
    "name": "Jon Harald Øymyr",
    "email": "joymyr@gmail.com"
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png"
  },
  "api": {
    "getStatus": {
      "method": "get",
      "path": "/status",
      "public": false
    },
    "syncVehicle": {
      "method": "post",
      "path": "/sync",
      "public": false
    }
  },
  "capabilities": {
    "sesam_unpaid_amount": {
      "type": "string",
      "title": {
        "en": "Unpaid Amount",
        "no": "Utestående beløp"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/icon.svg"
    },
    "sesam_facility": {
      "type": "string",
      "title": {
        "en": "Parking Facility",
        "no": "Parkeringsanlegg"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/icon.svg"
    },
    "sesam_hours_remaining": {
      "type": "string",
      "title": {
        "en": "Time Remaining",
        "no": "Gjenstående tid"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/icon.svg"
    },
    "sesam_payment_status": {
      "type": "string",
      "title": {
        "en": "⚙️ -> Maintenance -> Try to repair",
        "no": "⚙️ -> Vedlikehold -> Prøv å reparere"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/icon.svg"
    }
  },
  "drivers": [
    {
      "id": "vehicle",
      "name": {
        "en": "Vehicle",
        "no": "Kjøretøy"
      },
      "class": "other",
      "statusIndicator": "sesam_unpaid_amount",
      "capabilities": [
        "alarm_generic",
        "sesam_unpaid_amount",
        "sesam_hours_remaining",
        "sesam_facility",
        "sesam_payment_status"
      ],
      "capabilitiesOptions": {
        "alarm_generic": {
          "title": {
            "en": "Unpaid Parking",
            "no": "Ubetalt parkering"
          },
          "insightsTitleTrue": {
            "en": "Unpaid parking detected",
            "no": "Ubetalt parkering oppdaget"
          },
          "insightsTitleFalse": {
            "en": "No unpaid parking",
            "no": "Ingen ubetalt parkering"
          }
        }
      },
      "settings": [
        {
          "id": "reg_number",
          "type": "text",
          "label": {
            "en": "Registration Number",
            "no": "Registreringsnummer"
          },
          "hint": {
            "en": "e.g. AB12345",
            "no": "f.eks. AB12345"
          },
          "value": ""
        },
        {
          "id": "poll_interval",
          "type": "number",
          "label": {
            "en": "Poll interval (minutes)",
            "no": "Sjekkintervall (minutter)"
          },
          "hint": {
            "en": "How often to check for unpaid parkings (minimum 5 minutes)",
            "no": "Hvor ofte det skal sjekkes etter nye parkeringer (minimum 5 minutter)"
          },
          "value": 30,
          "min": 5,
          "max": 1440
        },
        {
          "id": "auto_timeline",
          "type": "checkbox",
          "label": {
            "en": "Automatic Timeline notification",
            "no": "Automatisk varsel i Homey Tidslinje"
          },
          "hint": {
            "en": "Automatically post to Homey Timeline when unpaid parking is found",
            "no": "Legg ut formatert varsel på tidslinjen når ny parkering oppdages"
          },
          "value": true
        },
        {
          "id": "email",
          "type": "text",
          "label": {
            "en": "Email for receipt (optional)",
            "no": "E-post for kvittering (valgfritt)"
          },
          "value": ""
        }
      ],
      "pair": [
        {
          "id": "add_vehicle"
        }
      ],
      "repair": [
        {
          "id": "pay_dashboard"
        }
      ],
      "images": {
        "small": "/drivers/vehicle/assets/images/small.png",
        "large": "/drivers/vehicle/assets/images/large.png"
      }
    }
  ],
  "flow": {
    "triggers": [
      {
        "id": "unpaid_parking_found",
        "title": {
          "en": "Unpaid parking detected",
          "no": "Ubetalt parkering oppdaget"
        },
        "hint": {
          "en": "Triggers when a new unpaid parking is detected for this vehicle.",
          "no": "Utløses når en ny ubetalt parkering oppdages for dette kjøretøyet."
        },
        "tokens": [
          {
            "name": "regnr",
            "type": "string",
            "title": {
              "en": "Registration number",
              "no": "Registreringsnummer"
            },
            "example": "AB12345"
          },
          {
            "name": "facility",
            "type": "string",
            "title": {
              "en": "Parking facility",
              "no": "Parkeringsanlegg"
            },
            "example": "BP Bygarasjen"
          },
          {
            "name": "amount",
            "type": "number",
            "title": {
              "en": "Amount (kr)",
              "no": "Beløp (kr)"
            },
            "example": 24
          },
          {
            "name": "hours_remaining",
            "type": "number",
            "title": {
              "en": "Hours remaining",
              "no": "Timer gjenstår av frist"
            },
            "example": 47.5
          },
          {
            "name": "deadline_str",
            "type": "string",
            "title": {
              "en": "Deadline (date/time)",
              "no": "Betalingsfrist (dato/tid)"
            },
            "example": "11.09.2026 11:39"
          },
          {
            "name": "formatted_message",
            "type": "string",
            "title": {
              "en": "Formatted message",
              "no": "Ferdig formatert varseltekst"
            },
            "example": "🚗 Ubetalt parkering: BP Bygarasjen (24 kr)..."
          },
          {
            "name": "payment_url",
            "type": "string",
            "title": {
              "en": "Payment link",
              "no": "Betalingslenke"
            },
            "example": "https://psp-ecommerce.payex.com/..."
          },
          {
            "name": "end_time",
            "type": "string",
            "title": {
              "en": "Exit time",
              "no": "Utkjøringstidspunkt"
            },
            "example": "09.09.2026 11:39"
          }
        ],
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=vehicle"
          }
        ]
      },
      {
        "id": "deadline_approaching",
        "title": {
          "en": "Payment deadline is approaching",
          "no": "Betalingsfristen utløper snart"
