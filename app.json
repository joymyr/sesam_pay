    "conditions": [
      {
        "id": "has_unpaid_parking",
        "title": {
          "en": "!{{Has|Does not have}} unpaid parking",
          "no": "!{{Har|Har ikke}} ubetalt parkering"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=vehicle"
          }
        ]
      },
      {
        "id": "any_has_unpaid_parking",
        "title": {
          "en": "!{{At least one|No}} vehicle has unpaid parking",
          "no": "!{{Minst ett|Ingen}} kjøretøy har ubetalt parkering"
        },
        "args": []
      }
    ],
    "actions": [
      {
        "id": "check_unpaid_now",
        "title": {
          "en": "Check unpaid parkings now",
          "no": "Sjekk ubetalte parkeringer nå"
        },
        "hint": {
          "en": "Checks this vehicle for unpaid parkings immediately.",
          "no": "Sjekker dette kjøretøyet for ubetalte parkeringer umiddelbart."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=vehicle"
          }
        ]
      },
      {
        "id": "check_all_vehicles_now",
        "title": {
          "en": "Check all vehicles now",
